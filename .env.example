# ==============================================================================
# NEXORA - Environment Variables Configuration
# ==============================================================================
# NOTE: Do NOT commit your actual .env file with real secrets to GitHub!
# The app automatically falls back to an offline/in-memory local storage mock
# if these credentials are blank, allowing full browsing, testing, and checkout.
# ==============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe to use in browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration
VITE_APP_NAME="NEXORA"
VITE_APP_TAGLINE="India's Premium Electronics & Lifestyle Marketplace"
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"

# Free delivery threshold in Indian Rupees
VITE_FREE_DELIVERY_THRESHOLD=499
VITE_STANDARD_DELIVERY_FEE=49
VITE_EXPRESS_DELIVERY_FEE=99

# Support contact info for Indian customers
VITE_SUPPORT_EMAIL="support@nexora.in"
VITE_SUPPORT_PHONE="+91 1800-209-8989"
VITE_SUPPORT_HOURS="Mon-Sat 9:00 AM - 9:00 PM IST"
